# Database
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/restaurant_os

# Auth
AUTH_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=restaurant_os_session

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM="Restaurant OS <no-reply@yourdomain.com>"

# Media (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Background jobs / cache / rate limiting (Upstash)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
QSTASH_TOKEN=

# Real-time (pluggable — see src/lib/realtime.ts)
REALTIME_PROVIDER=ably
ABLY_API_KEY=

# Defaults
DEFAULT_CURRENCY=KES
DEFAULT_TIMEZONE=Africa/Nairobi

# Optional local development seed settings
SEED_ADMIN_PASSWORD=
SEED_OWNER_EMAIL=owner@jmaranga-restaurant.local
